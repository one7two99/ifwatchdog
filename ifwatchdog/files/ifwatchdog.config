# ifwatchdog - see 'docs/SPEC.md'. Ships DISABLED and in monitor mode.
# Enable per instance only after you understand the action it will take.

config watchdog 'example'
	option enabled '0'
	# Interface to TEST (L3 device: wg iface for handshake, any for ping):
	option interface 'wg0'
	# Detection: handshake | ping | both
	option method 'both'
	option ping_host '1.1.1.1'
	option ping_timeout '3'
	option max_handshake_age '150'
	option interval '60'
	option failures '2'
	# Action when down: monitor (log only) | ifup | script
	option action 'monitor'
	# Network to restart on action=ifup (must NOT be lan/management):
	# option action_network 'wg0'
	# Root-owned, non-world-writable script for action=script:
	# option script '/usr/libexec/ifwatchdog.d/my-action.sh'
	# Extra protected networks (glob patterns, one per list entry):
	# list protected_networks 'mgmt*'
	option debounce '120'
	option max_actions '5'
	option action_window '3600'
	option log '1'

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# shellcheck shell=dash
# shellcheck disable=SC2034  # USE_PROCD/START/STOP are consumed by /etc/rc.common
# shellcheck disable=SC3043  # 'local' is supported by BusyBox ash (the target)
# shellcheck disable=SC2035  # cleanup globs are absolute paths, cannot start with -

USE_PROCD=1
START=95
STOP=10

CHECK=/usr/libexec/ifwatchdog.sh

start_instance() {
	local cfg="$1"
	local enabled
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance "$cfg"
	procd_set_param command "$CHECK" "$cfg"
	# Unlimited respawn is correct for a genuine crash, and safe ONLY because the
	# check script exits solely on SIGTERM/SIGINT: every other "cannot work"
	# condition idles (see main()), so a non-crash exit can never storm procd.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	# Status files are per-process and must not outlive it; the lock is an
	# O_EXCL regular file (rm, not rmdir) that a SIGKILLed holder may leave
	# behind. Both are cleared so the GUI never shows a dead instance as alive
	# and a fresh start is never blocked by a stale lock.
	# The .actions files are per-TARGET circuit-breaker state and are DELIBERATELY
	# kept: a config change goes through restart, and wiping them here would reset
	# the flapping brake on every "Save & Apply". Their timestamps are monotonic
	# (valid across a restart) and entries age out via action_window; a reboot
	# clears tmpfs, which is the one intended reset.
	rm -f /var/run/ifwatchdog/*.json /var/run/ifwatchdog/*.lock 2>/dev/null
	config_load ifwatchdog
	config_foreach start_instance watchdog
}

service_triggers() {
	procd_add_reload_trigger ifwatchdog
}

# Config is read at process start, so any change must fully restart the
# instances (procd would not restart them on a plain reload).
reload_service() {
	restart
}

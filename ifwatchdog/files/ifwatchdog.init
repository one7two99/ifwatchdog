#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# shellcheck shell=dash
# shellcheck disable=SC2034  # USE_PROCD/START/STOP are consumed by /etc/rc.common
# shellcheck disable=SC3043  # 'local' is supported by BusyBox ash (the target)
# shellcheck disable=SC2035  # cleanup globs are absolute paths, cannot start with -

USE_PROCD=1
START=95
STOP=10

CHECK=/usr/libexec/ifwatchdog.sh

start_instance() {
	local cfg="$1"
	local enabled
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance "$cfg"
	procd_set_param command "$CHECK" "$cfg"
	# Unlimited respawn is correct for a genuine crash, and safe ONLY because the
	# check script exits solely on SIGTERM/SIGINT: every other "cannot work"
	# condition idles (see main()), so a non-crash exit can never storm procd.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	# Drop stale state from a previous run (renamed/removed sections, SIGKILL,
	# and the pre-1.0 actions-file format) so the GUI never shows a dead instance
	# as alive and the breaker starts clean.
	rm -f /var/run/ifwatchdog/*.json /var/run/ifwatchdog/*.actions 2>/dev/null
	rmdir /var/run/ifwatchdog/*.lock 2>/dev/null
	config_load ifwatchdog
	config_foreach start_instance watchdog
}

service_triggers() {
	procd_add_reload_trigger ifwatchdog
}

# Config is read at process start, so any change must fully restart the
# instances (procd would not restart them on a plain reload).
reload_service() {
	restart
}
